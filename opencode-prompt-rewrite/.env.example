# Optional overrides for local benchmark generation and gateway usage accounting.
# Default gateway cost/usage folder used by the AI Gateway plugin:
GATEWAY_COST_DIR=~/.gateway-cost
GATEWAY_ENV_FILE=~/.config/ai-gateway/env

# Optional path to an enriched Artificial Analysis JSON file for refreshing data/model-benchmarks.json:
# MODEL_COMPARISON_FILE=/path/to/model_comparison/aa_output/models_aa_enriched.json
# PROMPT_REWRITE_BENCHMARKS_FILE=/path/to/custom/model-benchmarks.json
