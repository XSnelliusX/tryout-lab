# Gateway/benchmark data is read at runtime from the sibling ai-gateway module (see ../ai-gateway/README.md).
# All variables are optional; defaults match the ai-gateway module.

# Folder holding models.json (gateway catalog) and model-comparison/data/models.json (benchmarks):
GATEWAY_COST_DIR=~/.gateway-cost
# Env file the ai-gateway module writes; it may also define GATEWAY_COST_DIR / GATEWAY_PROVIDER_PREFIX:
GATEWAY_ENV_FILE=~/.config/ai-gateway/env
# Provider-id prefix of gateway providers not (yet) listed in the catalog, e.g. "gw" matches "gw-*":
# GATEWAY_PROVIDER_PREFIX=
# Set to 1 to stop logging rewrite usage into the gateway usage log:
# GATEWAY_USAGE_DISABLED=1

# Use a prebuilt benchmark db file instead of building from the two gateway files:
# PROMPT_REWRITE_BENCHMARKS_FILE=/path/to/prebuilt-benchmarks.json
