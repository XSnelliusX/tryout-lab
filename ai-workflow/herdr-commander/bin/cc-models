#!/usr/bin/env python3
"""Recommend and update the model of every Command Center role from benchmark data.

Usage:
  cc-models status
      Table of each role's current model: its workload score, $ per task, superseded or not.
  cc-models recommend [--profile lean|balanced|max --apply [--role a,b]] [--yes]
      One table: each role's current model next to the lean, balanced and max picks, with the
      average score and the cost of one task per role for each setup. --profile P --apply writes
      that profile's picks (all roles, or only --role ...), after a confirmation unless --yes.
  cc-models update [--yes]
      A new model was released: move each role to the newest version of the model line it already
      uses, at the same effort (GPT-6.1 Sol #high -> GPT-6.2 Sol #high). Never switches lines.
Options: --refresh rebuilds the comparison data first; --json prints machine-readable output.

The picks come from the model comparison's recommendation engine (ai-gateway
model-comparison/recommend.mjs), the same one the dashboard and the prompt rewriter use. Each role is
scored on its own workload (coding roles on agentic coding, the Commander on tool use, the architect on
planning), must reach a share of the best score available, and every doubling of cost must buy enough
extra score; lean, balanced and max differ in both. See the comparison's "Models per role" panel.

Data: $GATEWAY_COST_DIR/model-comparison/data/models.json (benchmarks with gateway prices).
Optional "model_policy" in models.json: "providers" (provider ids to pick from; default: the ones already
in use), "exclude" (model id patterns never to recommend, e.g. "*astra*"), "allow_max_effort" (default
false). Per role, "recommend": {"workload": "coding", "tier": "hard", "speed": 0} overrides the defaults.
Only `model` and `variant` change; the old models.json is backed up to ~/.setup_backup/.
"""
import argparse
import datetime
import json
import os
import re
import shutil
import subprocess
import sys

CONFIG = os.path.expanduser(os.environ.get("CC_CONFIG") or "~/.config/command-center/models.json")
COST_DIR = os.path.expanduser(os.environ.get("GATEWAY_COST_DIR") or "~/.gateway-cost")
COMPARISON_DIR = os.path.expanduser("~/.config/opencode/plugins/ai-gateway/model-comparison")
COMPARE_SCRIPT = os.path.join(COMPARISON_DIR, "compare.mjs")
ENGINE_SCRIPT = os.path.expanduser(os.environ.get("CC_RECOMMEND_SCRIPT") or os.path.join(COMPARISON_DIR, "recommend.mjs"))
EFFORTS = ["none", "minimal", "low", "medium", "high", "xhigh", "max"]
PROFILES = ["lean", "balanced", "max"]
# AA effort names -> gateway variant names (as in the engine).
EFFORT_TO_VARIANT = {"non-reasoning": "none", "minimal": "minimal", "low": "low", "medium": "medium",
                     "high": "high", "xhigh": "xhigh", "max": "max"}


def die(msg, code=2):
    print(f"[cc-models] {msg}", file=sys.stderr)
    sys.exit(code)


def load_json(path, what):
    try:
        with open(path) as f:
            return json.load(f)
    except FileNotFoundError:
        die(f"{what} not found: {path}")
    except ValueError as e:
        die(f"{what} is not valid JSON: {path}: {e}")


def split_model(spec):
    model, _, inline = (spec.get("model") or "").partition("#")
    return model, spec.get("variant") or inline or None


def routes_of(m):
    """Explicit gateway routes (snapshot schema 3). Older snapshots: only an unambiguous single pair."""
    if isinstance(m.get("gateway_routes"), list):
        return m["gateway_routes"]
    provs, ids = m.get("gateway_providers") or [], m.get("gateway_ids") or []
    if len(provs) != 1 or len(ids) != 1:
        return []
    price = m.get("pricing") or {}
    return [{"provider_id": provs[0], "model_id": ids[0], "effort_levels": None,
             "cost_per_task_usd": price.get("gateway_cost_per_task_usd")}]


def variant_for(m, route, cat_row):
    """Gateway variant that runs this AA variant on the route; False when it cannot (as in the engine)."""
    levels = route.get("effort_levels")
    if levels is None and cat_row is not None:
        levels = cat_row.get("effort_levels") or []
    wanted = EFFORT_TO_VARIANT.get(m.get("effort") or "")
    primary = m.get("is_primary") is not False
    if levels is None:
        return (wanted if wanted and wanted != "max" else None) if primary else False
    if not levels:
        return None if primary else False
    if wanted and wanted in levels:
        return wanted
    return None if not wanted and primary else False


def load_models(comp, cat):
    """One entry per gateway route + variant with benchmark data, plus release facts for `update`."""
    out = []
    for m in comp.get("models", []):
        name = m.get("release_name") or m.get("name") or ""
        nums = re.findall(r"\d+(?:\.\d+)*", name)
        for route in routes_of(m):
            key = f"{route['provider_id']}/{route['model_id']}"
            row = cat.get(key)
            if not row or row.get("tools") is False:
                continue
            variant = variant_for(m, route, row)
            if variant is False:
                continue
            out.append({
                "model": key, "variant": variant, "ii": (m.get("scores") or {}).get("intelligence"),
                "cost": route.get("cost_per_task_usd"),
                "release": name, "date": m.get("release_date"), "creator": m.get("creator"),
                "deprecated": bool(m.get("release_deprecated")),
                "line": " ".join(re.sub(r"\d+(?:\.\d+)*", " ", name.lower()).replace("-", " ").split()),
                "version": tuple(int(x) for x in nums[0].split(".")) if nums else (),
            })
    return out


def find(models, model, variant):
    return next((c for c in models if c["model"] == model and c["variant"] == variant), None)


def effort_rank(v):
    return EFFORTS.index(v) if v in EFFORTS else 99


def newer_version(cur, models, providers):
    """Newest non-deprecated release of the same line, at the same effort (else the nearest lower one)."""
    prov = cur["model"].split("/", 1)[0]
    same_line = [c for c in models if c["line"] == cur["line"] and c["creator"] == cur["creator"]
                 and c["version"] > cur["version"] and not c["deprecated"]
                 and c["model"].split("/", 1)[0] in set(providers) | {prov}]
    if not same_line:
        return None
    top = max(c["version"] for c in same_line)
    want = effort_rank(cur["variant"])
    return sorted([c for c in same_line if c["version"] == top], key=lambda c: (
        c["model"].split("/", 1)[0] != prov,      # same provider first
        effort_rank(c["variant"]) > want,         # never a higher effort
        abs(effort_rank(c["variant"]) - want),
        c["cost"] if c["cost"] is not None else float("inf")))[0]


def label(model, variant):
    """Short name for tables: the model id without a provider suffix that repeats the provider id."""
    prov, _, name = (model or "?/?").rpartition("/")
    tail = "-" + prov.rsplit("-", 1)[-1] if prov else ""
    if tail and name.endswith(tail) and len(name) > len(tail):
        name = name[: -len(tail)]
    return f"{name}#{variant}" if variant else name


def num(c, key, fmt):
    return fmt.format(c[key]) if c and c.get(key) is not None else "-"


def run_engine(comparison_file, policy):
    """The recommendation engine's picks per role (node recommend.mjs roles --json)."""
    script = os.path.expanduser(policy.get("engine") or ENGINE_SCRIPT)
    if not os.path.isfile(script) or not shutil.which("node"):
        die(f"needs node and the ai-gateway model comparison's recommendation engine ({script}): "
            "install it with ai-workflow/ai-gateway/install.sh --only compare")
    res = subprocess.run(["node", script, "roles", "--json", "--config", CONFIG, "--snapshot", comparison_file],
                         capture_output=True, text=True)
    if res.returncode:
        die((res.stderr or res.stdout).strip() or "the recommendation engine failed", 1)
    out = json.loads(res.stdout)
    if res.stderr.strip():
        print(res.stderr.strip(), file=sys.stderr)
    return out


def pick_of(result):
    """A role pick as {model, variant, score, cost, reason}, or None."""
    p = (result or {}).get("pick")
    if not p:
        return None
    return {"model": f"{p['provider_id']}/{p['model_id']}", "variant": p.get("variant"), "score": p.get("score"),
            "cost": p.get("cost_per_task_usd"), "reason": result.get("reason")}


def compare_table(rows, profiles):
    """One row per role: current model and each profile's pick ('=' when it is the current model)."""
    head = ["role", "scored on", "current", "score", "$"]
    for p in profiles:
        head += [p, "score", "$"]
    lines, totals = [], {k: [0.0, 0, 0.0] for k in ["current"] + profiles}
    for r in rows:
        cur = r["current"]
        line = [r["role"], f"{r['workload']}/{r['tier']}",
                label(cur["model"], cur["variant"]) + (" (old)" if cur.get("deprecated") else ""),
                num(cur, "score", "{:.1f}"), num(cur, "cost", "{:.2f}")]
        if cur.get("score") is not None:
            totals["current"][0] += cur["score"]; totals["current"][1] += 1; totals["current"][2] += cur.get("cost") or 0
        for p in profiles:
            c = r["picks"].get(p)
            same = c and (c["model"], c["variant"]) == (cur["model"], cur["variant"])
            line += ["=" if same else (label(c["model"], c["variant"]) if c else "-"), num(c, "score", "{:.1f}"), num(c, "cost", "{:.2f}")]
            if c:
                totals[p][0] += c["score"]; totals[p][1] += 1; totals[p][2] += c["cost"] or 0
        lines.append(line)
    summary = ["one task each", "", "", f"{totals['current'][0] / totals['current'][1]:.1f}" if totals["current"][1] else "-",
               f"{totals['current'][2]:.2f}"]
    for p in profiles:
        summary += ["", f"{totals[p][0] / totals[p][1]:.1f}" if totals[p][1] else "-", f"{totals[p][2]:.2f}"]
    numeric = {i for i, h in enumerate(head) if h in ("score", "$")}
    w = [max(len(x[i]) for x in [head] + lines + [summary]) for i in range(len(head))]
    fmt = lambda row: "  ".join(v.rjust(w[i]) if i in numeric else v.ljust(w[i]) for i, v in enumerate(row)).rstrip()
    rule = "  ".join("-" * x for x in w)
    print(fmt(head)); print(rule)
    for line in lines:
        print(fmt(line))
    print(rule); print(fmt(summary))


def update_table(rows):
    head = ("role", "current", "II", "$/task", "newer version", "II", "$/task")
    lines = []
    for r in rows:
        cur, new = r["current"], r["new"]
        same = new and (new["model"], new["variant"]) == (cur["model"], cur["variant"])
        old = " (superseded)" if cur["data"] and cur["data"]["deprecated"] else ""
        lines.append((r["role"], label(cur["model"], cur["variant"]) + old,
                      num(cur["data"], "ii", "{:.1f}"), num(cur["data"], "cost", "{:.2f}"),
                      "=" if same or not new else label(new["model"], new["variant"]),
                      "" if same or not new else num(new, "ii", "{:.1f}"), "" if same or not new else num(new, "cost", "{:.2f}")))
    w = [max(len(str(x[i])) for x in [head] + lines) for i in range(len(head))]
    fmt = lambda row: "  ".join(str(v).rjust(w[i]) if i in (2, 3, 5, 6) else str(v).ljust(w[i])
                                for i, v in enumerate(row)).rstrip()
    print(fmt(head))
    print("  ".join("-" * x for x in w))
    for row in lines:
        print(fmt(row))


def write(cfg, changes):
    stamp = datetime.datetime.now().strftime("%Y%m%d-%H%M%S")
    home = os.path.expanduser("~")
    rel = os.path.relpath(CONFIG, home) if CONFIG.startswith(home + os.sep) else "_root" + CONFIG
    bak = os.path.join(os.environ.get("SETUP_BACKUP_DIR") or os.path.join(home, ".setup_backup", stamp), rel)
    os.makedirs(os.path.dirname(bak), exist_ok=True)
    shutil.copy2(CONFIG, bak)
    for role, c in changes:
        spec = cfg["roles"][role]
        spec["model"] = c["model"]
        if c["variant"]:
            spec["variant"] = c["variant"]
        else:
            spec.pop("variant", None)
    tmp = f"{CONFIG}.{os.getpid()}.tmp"
    with open(tmp, "w") as f:
        f.write(json.dumps(cfg, indent=2, ensure_ascii=False) + "\n")
    os.replace(tmp, CONFIG)
    return bak


def confirm(n, yes):
    if yes:
        return True
    if not sys.stdin.isatty():
        print("\nNothing written (no terminal to confirm in): add --yes.")
        return False
    try:
        ok = input(f"\nApply {n} change(s) to {CONFIG}? [y/N] ").strip().lower() in ("y", "yes")
    except EOFError:
        ok = False
    if not ok:
        print("Nothing written.")
    return ok


def main():
    if len(sys.argv) < 2 or sys.argv[1] in ("-h", "--help"):
        print(__doc__.strip())
        return
    ap = argparse.ArgumentParser(prog="cc-models", add_help=False)
    ap.add_argument("cmd", choices=["status", "recommend", "update"])
    ap.add_argument("--profile", choices=PROFILES)
    ap.add_argument("--apply", action="store_true")
    ap.add_argument("--role", help="with --apply: only these roles (comma-separated)")
    ap.add_argument("--yes", "-y", action="store_true")
    ap.add_argument("--refresh", action="store_true")
    ap.add_argument("--json", action="store_true")
    a = ap.parse_args()

    cfg = load_json(CONFIG, "config")
    pol = cfg.get("model_policy") or {}
    if a.refresh:
        if not os.path.isfile(COMPARE_SCRIPT) or not shutil.which("node"):
            die(f"--refresh needs node and the ai-gateway model comparison ({COMPARE_SCRIPT})")
        if subprocess.run(["node", COMPARE_SCRIPT, "--no-open", "--quiet"], stdout=sys.stderr).returncode:
            die("refreshing the comparison data failed", 1)
    comparison_file = os.path.expanduser(pol.get("comparison_file") or os.path.join(COST_DIR, "model-comparison/data/models.json"))
    comp = load_json(comparison_file, "comparison data (build it with --refresh; needs the ai-gateway plugin)")
    roles = cfg.get("roles") or {}
    wanted = {r.strip() for r in a.role.split(",")} if a.role else None
    if wanted and wanted - set(roles):
        die(f"unknown role(s): {', '.join(sorted(wanted - set(roles)))}")

    if a.cmd in ("status", "recommend"):
        if a.apply and not a.profile:
            die("--apply needs --profile lean|balanced|max (which recommendation to write)")
        engine = run_engine(comparison_file, pol)
        rows = []
        for r in engine["roles"]:
            c = r["current"]
            rows.append({"role": r["role"], "workload": r["workload"], "tier": r["tier"],
                         "current": {"model": c["model"], "variant": c["variant"], "score": c.get("score"),
                                     "cost": c.get("cost_per_task_usd"), "deprecated": c.get("deprecated", False),
                                     "known": c.get("known", False), "placeholder": c.get("placeholder", False)},
                         "picks": {p: pick_of(r["picks"].get(p)) for p in PROFILES}})
        if a.cmd == "status":
            if a.json:
                print(json.dumps({"data": comp.get("generated_at"), "roles": [
                    {"role": r["role"], "workload": r["workload"], "tier": r["tier"], **r["current"]} for r in rows]}, indent=2))
                return
            print(f"data {comp.get('generated_at')}   score = the role's workload score (see cc-models --help)\n")
            lines = [("role", "model", "scored on", "score", "$/task", "note")]
            for r in rows:
                c = r["current"]
                note = ("placeholder: run cc-models recommend --profile balanced --apply" if c["placeholder"] else
                        "superseded: see cc-models update" if c["deprecated"] else
                        "not on the gateway or no benchmark data for this effort" if not c["known"] else "")
                lines.append((r["role"], label(c["model"], c["variant"]), f"{r['workload']}/{r['tier']}",
                              num(c, "score", "{:.1f}"), num(c, "cost", "{:.2f}"), note))
            w = [max(len(x[i]) for x in lines) for i in range(6)]
            for n, row in enumerate(lines):
                print("  ".join(v.rjust(w[i]) if i in (3, 4) else v.ljust(w[i]) for i, v in enumerate(row)).rstrip())
                if n == 0:
                    print("  ".join("-" * x for x in w[:5]))
            return
        for r in rows:
            r["new"] = r["picks"].get(a.profile) if a.profile else None
        providers = engine.get("providers") or []
    else:
        catalog = load_json(os.path.expanduser(pol.get("catalog_file") or os.path.join(COST_DIR, "models.json")),
                            "gateway catalog (written by the ai-gateway plugin)")
        cat = {f"{r.get('provider_id')}/{r.get('model_id')}": r for r in catalog.get("rows", [])}
        models = load_models(comp, cat)
        in_use = {split_model(s)[0].split("/", 1)[0] for s in roles.values()
                  if "/" in split_model(s)[0] and "<" not in split_model(s)[0]}
        providers = pol.get("providers") or sorted(in_use) or sorted({k.split("/", 1)[0] for k in cat})
        rows = []
        for role, spec in roles.items():
            model, variant = split_model(spec)
            line = find(models, model, variant) or next((c for c in models if c["model"] == model), None)
            cur = dict(line, variant=variant) if line else None
            rows.append({"role": role, "current": {"model": model, "variant": variant, "data": find(models, model, variant)},
                         "new": newer_version(cur, models, providers) if cur else None})

    changes = [(r["role"], r["new"]) for r in rows if r["new"]
               and (r["new"]["model"], r["new"]["variant"]) != (r["current"]["model"], r["current"]["variant"])
               and (not wanted or r["role"] in wanted)]

    if a.json:
        print(json.dumps({"data": comp.get("generated_at"), "providers": providers,
                          "profile": a.profile, "roles": rows,
                          "changes": [{"role": r, "model": c["model"], "variant": c["variant"]} for r, c in changes]}, indent=2))
    else:
        print(f"data {comp.get('generated_at')}   providers {', '.join(providers)}\n")
        if a.cmd == "recommend":
            compare_table(rows, PROFILES)
            if a.profile:
                print(f"\nWhy ({a.profile}):")
                for r in rows:
                    c = r["picks"].get(a.profile)
                    if c and (not wanted or r["role"] in wanted):
                        print(f"  {r['role']}: {c['reason']}")
        else:
            update_table(rows)
        if a.cmd == "update" and not changes:
            print("\nEvery role already runs the newest version of its model line.")
        for r in rows:
            d = r["current"].get("data")
            if a.cmd == "update" and d and d["deprecated"] and not r["new"]:
                print(f"! {r['role']}: {d['release']} is superseded and has no newer version on your gateway; choose one by hand.")
        if a.cmd == "recommend" and not a.apply:
            print("\n'=' = same as current; score = the role's workload score. "
                  "Apply one: cc-models recommend --profile lean|balanced|max --apply [--role a,b]")
        if a.cmd == "recommend" and a.apply:
            print(f"\nApplying the {a.profile} picks" + (f" for {', '.join(sorted(wanted))}" if wanted else "") + f": {len(changes)} change(s).")
    if not changes or (a.cmd == "recommend" and not a.apply) or (a.json and not a.yes):
        return
    if confirm(len(changes), a.yes):
        bak = write(cfg, changes)
        msg = f"Wrote {CONFIG} (backup: {bak}). New workers use it at once; the Commander after cc-commander --restart."
        print(json.dumps({"written": True, "backup": bak}) if a.json else msg)


if __name__ == "__main__":
    main()
